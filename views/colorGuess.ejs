<!DOCTYPE html>
<html>
	<head>
		<!-- Stylesheet for PC devices -->
		<link rel="stylesheet" type="text/css" href="/stylesheets/main.css">

		<!-- Google Fonts CDN -->
		<link rel="preconnect" href="https://fonts.gstatic.com">
		<link href="https://fonts.googleapis.com/css2?family=Expletus+Sans&family=Cormorant+Unicase:wght@500&family=Kurale&family=Righteous&family=Satisfy&family=Spirax&display=swap" rel="stylesheet">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Blaka+Hollow&family=Caveat+Brush&family=Chicle&family=Permanent+Marker&family=Slackey&display=swap" rel="stylesheet">

		<!-- Font share CDN -->
		<link href="https://api.fontshare.com/v2/css?f[]=bespoke-serif@400,401,500,501,700,701&f[]=bespoke-stencil@400,401,500,700,800,801,1,2&f[]=britney@400,700,1000,1&f[]=melodrama@400,500,600,700&f[]=dancing-script@400,700&display=swap" rel="stylesheet">

		<title>Color Game</title>
		
		<!-- Tab icon -->
		<link rel = "icon" href = "/images/colorgame.png" type = "image/x-icon"> 
	</head>

	<body id="guessColor"class="animate fadeIn delay">
		<!-- Banner -->
		<h1 id="gameTitle">
			The Color Game
			<br>
			<span id="colorDisplay">RGB</span> 
		</h1>

		<h2 id="gameInstruction">Guess which color matches the above RGB combination</h2>

		<!-- Button tray -->
		<div id="stripe">
			<button id="reset" class="gameButton">New Colors</button>
			<span id="message"></span>
			<button class="mode gameButton">Easy</button>
			<button class="mode selected gameButton">Hard</button>
		</div>

		<!-- Color boxes -->
		<div id="container">
			<div class="square"></div>
			<div class="square"></div>
			<div class="square"></div>
			<div class="square"></div>
			<div class="square"></div>
			<div class="square"></div>
		</div>

		<!-- Custom JavaScript -->
		<script type="text/javascript" src="/scripts/colorGuess.js"></script>
	</body>
</html>